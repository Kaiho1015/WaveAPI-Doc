{
  "$schema": "https://mintlify.com/docs.json",
  "name": "QWave API",
  "theme": "maple",
  "colors": {
    "primary": "#0EA5E9",
    "light": "#38BDF8",
    "dark": "#0284C7"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "appearance": {
    "default": "system"
  },
  "background": {
    "decoration": "gradient"
  },
  "styling": {
    "eyebrows": "section",
    "codeblocks": "system"
  },
  "search": {
    "prompt": "Search docs..."
  },
  "api": {
    "examples": {
      "languages": [
        "curl",
        "python",
        "javascript",
        "go",
        "java"
      ]
    },
    "playground": {
      "display": "simple"
    }
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://qingbo.dev/dashboard/keys"
    }
  },
  "redirects": [
    {
      "source": "/cn/api-reference/image/gpt-image",
      "destination": "/cn/api-reference/image/gpt-image/overview"
    },
    {
      "source": "/cn/api-reference/image/gpt-image-2-rev",
      "destination": "/cn/api-reference/image/gpt-image/gpt-image-2-rev"
    },
    {
      "source": "/en/api-reference/image/gpt-image",
      "destination": "/en/api-reference/image/gpt-image/overview"
    },
    {
      "source": "/en/api-reference/image/gpt-image-2-rev",
      "destination": "/en/api-reference/image/gpt-image/gpt-image-2-rev"
    },
    {
      "source": "/cn/api-reference/image/gemini",
      "destination": "/cn/api-reference/image/gemini/overview"
    },
    {
      "source": "/en/api-reference/image/gemini",
      "destination": "/en/api-reference/image/gemini/overview"
    },
    {
      "source": "/cn/api-reference/video/omni",
      "destination": "/cn/api-reference/video/omni/overview"
    },
    {
      "source": "/en/api-reference/video/omni",
      "destination": "/en/api-reference/video/omni/overview"
    }
  ],
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Status",
          "icon": "signal",
          "href": "https://status.qingboai.com"
        },
        {
          "anchor": "GitHub",
          "icon": "github",
          "href": "https://github.com/Kaiho1015/docs"
        }
      ]
    },
    "languages": [
      {
        "language": "cn",
        "tabs": [
          {
            "tab": "文档",
            "icon": "book-open",
            "groups": [
              {
                "group": "开始",
                "pages": [
                  "cn/index",
                  "cn/guides/quickstart",
                  "cn/docs/authentication"
                ]
              },
              {
                "group": "核心概念",
                "pages": [
                  "cn/docs/request-response",
                  "cn/docs/sync-async",
                  "cn/docs/task-system",
                  "cn/docs/streaming",
                  "cn/docs/models"
                ]
              }
            ]
          },
          {
            "tab": "API 参考",
            "icon": "code",
            "groups": [
              {
                "group": "文本生成",
                "pages": [
                  "cn/api-reference/text/overview",
                  "cn/api-reference/text/general-chat",
                  "cn/api-reference/text/openai-multimodal",
                  "cn/api-reference/text/claude-messages",
                  "cn/api-reference/text/gemini-native"
                ]
              },
              {
                "group": "图像生成",
                "pages": [
