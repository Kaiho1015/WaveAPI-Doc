              },
              {
                "group": "工具与嵌入",
                "pages": [
                  "cn/api-reference/tools/embeddings",
                  "cn/api-reference/tools/moderations"
                ]
              },
              {
                "group": "任务管理",
                "pages": [
                  "cn/api-reference/task/submit",
                  "cn/api-reference/task/status",
                  "cn/api-reference/task/cancel"
                ]
              },
              {
                "group": "账户与用量",
                "pages": [
                  "cn/api-reference/account/balance",
                  "cn/api-reference/account/usage",
                  "cn/api-reference/account/subscription"
                ]
              }
            ]
          },
          {
            "tab": "产品动态",
