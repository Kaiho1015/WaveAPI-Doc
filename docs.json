                  "cn/api-reference/video/grok-imagine-video",
                  "cn/api-reference/video/sora",
                  "cn/api-reference/video/pixverse",
                  {
                    "group": "Omni 视频系列",
                    "root": "cn/api-reference/video/omni/overview",
                    "expanded": true,
                    "pages": [
                      "cn/api-reference/video/omni/omni-flash-ext",
                      "cn/api-reference/video/omni/gemini-omni-flash"
                    ]
                  }
                ]
              },
              {
                "group": "音频处理",
                "pages": [
                  "cn/api-reference/audio/tts",
                  "cn/api-reference/audio/suno",
                  "cn/api-reference/audio/flow-music/flow-music",
                  "cn/api-reference/audio/whisper-transcription"
