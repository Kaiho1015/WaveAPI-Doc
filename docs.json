                      "cn/api-reference/image/gemini/nano-banana-rev"
                    ]
                  },
                  {
                    "group": "GPT Image 系列",
                    "root": "cn/api-reference/image/gpt-image/overview",
                    "expanded": true,
                    "pages": [
                      "cn/api-reference/image/gpt-image/gpt-image-1",
                      "cn/api-reference/image/gpt-image/gpt-image-2",
